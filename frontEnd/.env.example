# Copy this file to .env and set only the values needed for your environment.
# Vite exposes client variables only when their names begin with VITE_.

# Local development. apiEnv.ts falls back to localhost:5212 when these are unset.
# VITE_API_BASE=http://127.0.0.1:5212/api
# VITE_API_ORIGIN=http://127.0.0.1:5212

# Production build variables belong in the hosting platform. Never expose secrets here.
# The API base must include /api.
# VITE_API_BASE=https://api.igabeverlyhills.com/api
# Set this only when static assets and the API use different origins.
# VITE_API_ORIGIN=https://your-backend.up.railway.app

# Optional public storefront origin. Keep it aligned with Stripe redirects and backend CORS.
# VITE_PUBLIC_SITE_ORIGIN=https://www.igabeverlyhills.com

# Address suggestions are requested by the backend, so no Mapbox token is exposed to Vite.
# Configure Mapbox__AccessToken or MAPBOX_ACCESS_TOKEN on the API service.
# When the token has URL restrictions, also configure a matching Mapbox__RefererUrl.
